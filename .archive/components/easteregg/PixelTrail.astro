    }
    resize();
    window.addEventListener('resize', resize);

    const pixelSize = 14; 
    const fadeSpeed = 0.04; 
    let pixels = [];
    let animationFrameId;

    let lastX = null;
    let lastY = null;
    let colorIndex = 0;

    
    const colors = [
      [255, 244, 48],   // Yellow
      [252, 252, 252],  // White
      [156, 89, 209],   // Purple
      [44, 44, 44],     // black
      [91, 206, 250],   // Light Blue
      [245, 169, 184],  // Pink
      [252, 252, 252],  // White
      [245, 169, 184],  // Pink
      [91, 206, 250]    // Light Blue
    ];

    const handleMouseMove = (e) => {
      const currentX = e.clientX;
      const currentY = e.clientY;

      if (lastX === null || lastY === null) {
        lastX = currentX;
        lastY = currentY;
        return;
      }

      const dx = currentX - lastX;
      const dy = currentY - lastY;
      const distance = Math.hypot(dx, dy);
      const steps = Math.max(Math.floor(distance / (pixelSize / 2)), 1);

      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const interpX = lastX + dx * t;
        const interpY = lastY + dy * t;

        const gridX = Math.floor(interpX / pixelSize) * pixelSize;
        const gridY = Math.floor(interpY / pixelSize) * pixelSize;

        const lastPixel = pixels[pixels.length - 1];
        if (!lastPixel || lastPixel.x !== gridX || lastPixel.y !== gridY) {
          const currentColor = colors[colorIndex % colors.length];
          colorIndex++;

          pixels.push({ 
            x: gridX, 
            y: gridY, 
            alpha: 1.0, 
            r: currentColor[0], 
            g: currentColor[1], 
            b: currentColor[2] 
          });
        }
      }

      lastX = currentX;
      lastY = currentY;
    };

